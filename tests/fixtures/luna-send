#!/bin/sh
# Заглушка luna-send для тестов на ПК (tests/test_shell.sh, tests/test_installer.sh).
#   Все вызовы - в $FAKE_LUNA_LOG. Как на OLED65M59LA (10.3.0): stdin не /dev/null или терминал (канал ssh)
#   -> ничего не выводит.  FAKE_INSTALL: ok (по умолчанию) | silent (без вывода) | fail | hang
#   FAKE_ARC_FILE: файл с числом -> eim/getArcVolume отвечает {"Volume":N}; без файла - "Unknown method"
[ -n "${FAKE_LUNA_LOG:-}" ] && echo "$*" >> "$FAKE_LUNA_LOG"
[ -c /dev/stdin ] || exec >/dev/null
for a in "$@"; do payload=$a; done
field() { printf '%s' "$payload" | sed -n "s/.*\"$1\":\"\([^\"]*\)\".*/\1/p"; }
app_dir() {
	for base in $APP_BASES; do
		if [ -f "$base/$1/appinfo.json" ]; then echo "$base/$1"; return 0; fi
	done
	return 1
}
case "$*" in
	*getVolume*)   # громкость ТВ 17, без mute (как отвечает audio service); с subscribe - подписка
		echo '{"returnValue":true,"volumeStatus":{"soundOutput":"external_arc","volume":17,"muteStatus":false}}'
		case $payload in *'"subscribe":true'*) while :; do sleep 1; done ;; esac ;;
	*eim/getArcVolume*)   # OLED65M59LA (10.3.0) отвечает {"Volume":10}, без returnValue
		if [ -n "${FAKE_ARC_FILE:-}" ] && [ -s "$FAKE_ARC_FILE" ]; then
			echo "{\"Volume\":$(cat "$FAKE_ARC_FILE")}"
		else
			echo '{"returnValue":false,"errorCode":-1,"errorText":"Unknown method \"getArcVolume\" for category \"/\""}'
		fi ;;
	*getSystemInfo*)
		echo '{"returnValue":true,"modelName":"OLED55C46LA","firmwareVersion":"33.21.65","sdkVersion":"9.2.0"}' ;;
	*appInstallService/dev/install*)
		mode=${FAKE_INSTALL:-ok}
		[ "$mode" = silent ] || [ "$mode" = hang ] || echo '{"returnValue":true,"subscribed":true}'
		if [ "$mode" = fail ]; then
			echo '{"details":{"errorCode":-5,"reason":"FAILED_IPKG_INSTALL"},"statusValue":21,"returnValue":true}'
			exit 0
		fi
		if [ "$mode" != hang ]; then
			# как appInstallService: ./usr/palm/applications/<id>/ из data.tar.gz -> первый каталог APP_BASES
			# shellcheck disable=SC2086  # список каталогов через пробел
			set -- $APP_BASES
			python3 - "$(field ipkUrl)" "$1" <<'PY' || exit 1
import io, os, shutil, sys, tarfile
data = open(sys.argv[1], "rb").read()
assert data[:8] == b"!<arch>\n"
pos, members = 8, {}
while pos < len(data):
    name, size = data[pos:pos + 16].decode().strip(), int(data[pos + 48:pos + 58])
    members[name] = data[pos + 60:pos + 60 + size]
    pos += 60 + size + size % 2
prefix = "./usr/palm/applications/"
with tarfile.open(fileobj=io.BytesIO(members["data.tar.gz"])) as tar:
    ids = {m.name[len(prefix):].split("/")[0] for m in tar.getmembers() if m.name.startswith(prefix) and len(m.name) > len(prefix)}
    for app in ids:
        shutil.rmtree(os.path.join(sys.argv[2], app), ignore_errors=True)
    for m in tar.getmembers():
        if m.isfile() and m.name.startswith(prefix):
            dst = os.path.join(sys.argv[2], m.name[len(prefix):])
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            with open(dst, "wb") as f:
                f.write(tar.extractfile(m).read())
PY
		fi
		[ "$mode" = ok ] && echo '{"details":{"state":"installed"},"statusValue":30,"subscribed":true,"returnValue":true}'
		while :; do sleep 1; done ;;    # подписка остаётся открытой, пока luna-send не остановят
	*appInstallService/dev/remove*)
		id=$(field id)
		echo '{"returnValue":true}'
		( sleep 1; for base in $APP_BASES; do rm -rf "${base:?}/$id"; done ) </dev/null >/dev/null 2>&1 & ;;
	*applicationManager/getAppInfo*)
		if dir=$(app_dir "$(field id)"); then
			ver=$(sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' "$dir/appinfo.json" | head -n 1)
			echo "{\"returnValue\":true,\"appInfo\":{\"id\":\"$(field id)\",\"version\":\"$ver\"}}"
		else
			echo '{"returnValue":false,"errorText":"Cannot find proper launchPoint"}'
		fi ;;
	*applicationManager/getForegroundAppInfo*)
		echo '{"returnValue":true,"appId":"tld.my.customlauncher","windowId":"","processId":""}' ;;
	*applicationManager/launch*)
		if app_dir "$(field id)" >/dev/null; then
			echo '{"returnValue":true}'
		else
			echo '{"returnValue":false,"errorText":"app not found"}'
		fi ;;
	*) echo '{"returnValue":true}' ;;
esac
